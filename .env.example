# SGSP voice agent — copy to .env and fill in. Only the first block is required.

# ── Required ─────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_API_DOMAIN=api.in.exotel.com
# App Studio flow (Call Start → Stream → wss://<public-host>/sgsp/stream), start_voice form:
SGSP_EXOTEL_FLOW_URL=http://my.in.exotel.com/<sid>/exoml/start_voice/<flow-id>
# An ExoPhone owned by this Exotel account
SGSP_EXOTEL_CALLER_ID=
SGSP_EXOTEL_STATUS_CALLBACK_URL=https://<public-host>/sgsp/call-status
# Protects the dashboard / campaign / call endpoints (header X-Admin-Token) — set it anywhere but localhost
SGSP_ADMIN_TOKEN=

# ── Optional (defaults shown) ────────────────────────────────────────────────
SGSP_GEMINI_MODEL=gemini-3.8-live
SGSP_VOICE=Charon
SGSP_AGENCY_KN=ಕರ್ನಾಟಕ ಸರ್ಕಾರದ
SGSP_AGENCY_EN=the Government of Karnataka
SGSP_DISPATCHER=true
SGSP_CHANNEL_LIMIT=5
SGSP_CALL_HOURS_START=10
SGSP_CALL_HOURS_END=19
SGSP_CALL_ON_SUNDAYS=false
SGSP_MAX_ATTEMPTS=3
SGSP_RETRY_DELAYS_MIN=60,240
SGSP_NO_RESPONSE_PROMPT_S=8
SGSP_WEBHOOK_URL=

# SMS (off until a DLT-registered sender ID and template exist)
SGSP_SMS_ENABLED=false
SGSP_SMS_SENDER_ID=
SGSP_SMS_DLT_ENTITY_ID=
SGSP_SMS_DLT_TEMPLATE_ID=
# SGSP_SMS_TEMPLATE=<exact DLT-approved text; leave commented to use the built-in one>
